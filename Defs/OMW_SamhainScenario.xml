<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>OMW_SamhainScenario</defName>
    <label>Shadows Over the Rim</label>
		<description>They move like ghosts through the high grass, faces hidden behind pale cloth and carved resin, small blades gripped tightly in child-like hands. The Samhain were never meant for open fields or warm welcomes—only the quiet margins of a hostile world. For years, your trio has lived as wandering night-hunters, moving from campsite to campsite and relying on swift steel, shared secrets, and the occasional stolen luxury of cocoa to keep the cold at bay. But constant drifting has grown weary, and even the shadows need a place to root. Your small pack has finally halted, looking out over a untouched expanse of wilderness, ready to carve out a sanctuary to call forever home.

NOTE: The Samhain are unable to research. Acquiring a researcher is of the utmost importance.</description>
	<scenario>
		<summary>3 Samhain youth, 3 knives, 100 chocolate, 300 human meat.</summary>
		<parts>
			<li Class="ScenPart_PlanetLayer">
				<def>PlanetLayer</def>
				<layer>Orbit</layer>
				<settingsDef>Orbit</settingsDef>
				<hide>True</hide>
				<tag>Orbit</tag>
				<connections>
					<li>
						<tag>Surface</tag>
						<zoomMode>ZoomIn</zoomMode>
					</li>
				</connections>
			</li>
			<li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
				<def>ConfigurePawnsXenotypes</def>
				<pawnChoiceCount>3</pawnChoiceCount>
				<xenotypeCounts>
					<li>
						<count>3</count>
						<requiredAtStart>True</requiredAtStart>
						<xenotype>OMW_Samhain</xenotype>
						<allowedDevelopmentalStages>Baby, Child, Adult</allowedDevelopmentalStages>
						<description>Samhain</description>
					</li>
				</xenotypeCounts>
			</li>
			<li Class="ScenPart_PlayerPawnsArriveMethod">
				<def>PlayerPawnsArriveMethod</def>
			</li>
			<li Class="ScenPart_PawnFilter_Age">
