<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenPartDef>
    <defName>OMW_SamhainScenarioSetup</defName>
    <label>Samhain scenario setup</label>
    <scenPartClass>SamhainXenotype.ScenPart_SamhainScenarioSetup</scenPartClass>
    <category>Fixed</category>
    <summaryPriority>1000</summaryPriority>
  </ScenPartDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>OMW_SamhainScenario</defName>
    <label>Sweet Septober</label>
    <description>Three Samhain chasing an Ancient who doesn't celebrate the fall harvest. A hostile Ancient waits at the far edge of the map.</description>
    <scenario>
      <summary>Three Samhain, 100 chocolate, 300 human meat, and a hostile Ancient.</summary>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>Start with three Samhain.</customSummary>
          <xenotypeCounts>
            <li>
              <xenotype>OMW_Samhain</xenotype>
              <count>3</count>
              <description>Samhain</description>
              <requiredAtStart>true</requiredAtStart>
            </li>
          </xenotypeCounts>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <visible>false</visible>
          <method>DropPods</method>
        </li>
        <li Class="SamhainXenotype.ScenPart_SamhainScenarioSetup">
          <def>OMW_SamhainScenarioSetup</def>
          <visible>false</visible>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Steel</stuff>
          <count>3</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Chocolate</thingDef>
          <count>100</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Meat_Human</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>It's septober. The fall has come, and three Samhain have arrived on the rim. A hostile Ancient is somewhere at the far side of the map.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
