<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PsychicRitualRoleDef>
    <defName>OMW_SamhainSacrifice</defName>
    <label>sacrifice</label>
    <allowedCount>1</allowedCount>
    <allowedConditions>Default, Downed, Prisoner, Slave, Sleeping, IdeoUnwilling</allowedConditions>
    <applyPowerOffset>false</applyPowerOffset>
    <removeOnLost>false</removeOnLost>
  </PsychicRitualRoleDef>
  <PsychicRitualDef Class="SamhainXenotype.PsychicRitualDef_SamhainRecruit">
    <defName>OMW_SamhainRitual</defName>
    <label>Blood and Chocolate</label>
    <description>Give an offering of blood and chocolate to invite the Samhain to your colony.</description>
    <outcomeDescription>A Samhain wanderer will join after the ritual.</outcomeDescription>
    <researchPrerequisite>BasicPsychicRituals</researchPrerequisite>
    <targetRole>OMW_SamhainSacrifice</targetRole>
    <hoursUntilOutcome>4</hoursUntilOutcome>
    <hoursUntilHoraxEffect>1</hoursUntilHoraxEffect>
    <requiredOffering>
      <filter>
        <thingDefs><li>Chocolate</li></thingDefs>
      </filter>
      <count>10</count>
    </requiredOffering>
    <cooldownHours>120</cooldownHours>
    <iconPath>UI/PsychicRituals/OMW_SamhainRitual</iconPath>
  </PsychicRitualDef>
</Defs>
